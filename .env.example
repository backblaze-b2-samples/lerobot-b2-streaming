# Backblaze B2 (required)
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Optional: public base URL for objects (only if your bucket is public).
# Leave blank to rely on presigned URLs for browser playback (default).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K000abcdefghijklmnopqrstuvwxyz0
# B2_BUCKET_NAME=my-lerobot-datasets
# B2_PUBLIC_URL_BASE=https://my-lerobot-datasets.s3.us-west-004.backblazeb2.com
